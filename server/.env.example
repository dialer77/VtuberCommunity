# 폴링 간격(ms). 실서비스는 60000~300000 권장.
POLL_INTERVAL_MS=60000

# 데모용: N 사이클 후 자동 종료 (0 = 무한 실행)
MAX_CYCLES=0

# 저장소 선택: sqlite(기본, 자체 DB) | memory | postgres
STORE=sqlite

# SQLite 파일 경로
DB_PATH=./data/vmoa.db

# REST API 포트
API_PORT=4000

# 치지직 라이브 페이징 수 (50개/페이지). 8이면 상위 400개를 훑어 버튜버를 걸러냄.
# 치지직엔 '버추얼' 카테고리가 없어 전체 라이브를 훑어야 커버리지가 나온다.
CHZZK_PAGES=8

# 스냅샷 보존 기간(일). 초과분 자동 삭제로 DB 무한 증가 방지.
RETENTION_DAYS=7

# 유저 데이터 API(즐겨찾기 등) 보호용 공유 시크릿. 웹 서버와 동일 값으로.
# 비어있으면 유저 API는 401(비활성). 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SECRET=

# postgres 사용 시 연결 문자열
# DATABASE_URL=postgres://user:pass@host:5432/vmoa

# ---- 이슈 자동 수집 (Claude 구독 + Claude Code 헤드리스) — docs/issue-collector.md
# 1 이면 ISSUES_INTERVAL_MIN 마다 웹 검색으로 이슈를 정리해 올림
ISSUES_ENABLED=0
ISSUES_INTERVAL_MIN=180
ISSUES_MAX_PER_RUN=5
# claude.exe 경로 (비우면 자동 탐색). 배포 PC(SYSTEM 실행)에서는 절대 경로 필수
CLAUDE_BIN=
# 구독 인증 토큰 (`claude setup-token` 으로 발급). API 키는 쓰지 않음
CLAUDE_CODE_OAUTH_TOKEN=
# 모델 (비우면 구독 계정 기본값)
CLAUDE_MODEL=
# 신규 데뷔 웹 수집 (기본: ISSUES_ENABLED 를 따라감) — 주기(분)·1회 최대 건수
# DEBUTS_ENABLED=1
DEBUTS_INTERVAL_MIN=360
DEBUTS_MAX_PER_RUN=15

# ---- YouTube Data API (docs/youtube-api.md, 값은 deploy/windows/setup-youtube.ps1 이 채움)
# 서버에만 둔다. 공개 저장소·웹(Vercel)에 넣지 말 것
YOUTUBE_API_KEY=
# 공식 채널 연동(매핑·RSS·라이브 감지)은 키가 있으면 켜짐. 1 = 키 없이 매핑·RSS 만(개발용), 0 = 끔
# YOUTUBE_SYNC=
# 하루 할당량 예산(단위, 기본 한도 10000 중). 80% 를 넘으면 방송 중 확인만 계속
YOUTUBE_DAILY_BUDGET=8000
# 매핑 대상: 월간 시청시간 상위 N + 지금 방송 중 + 확정 목록
YOUTUBE_MAP_TOP=200

# ---- 키리누키 수집·분류 (docs/youtube-api.md 4장). 기본은 ISSUES_ENABLED 를 따라감 + YouTube 키 필요
# CLIPS_ENABLED=1
# 하루 search.list 횟수 (1회 100단위로 셈) · 채널을 찾을 버튜버 범위(월간 상위 N)
CLIPS_SEARCH_PER_DAY=20
CLIPS_TOP=150
# 분류 주기(분) · 한 번에 분류할 클립 수 (Claude 구독)
CLIPS_CLASSIFY_INTERVAL_MIN=30
CLIPS_CLASSIFY_BATCH=50

# ---- 로그인·최애·알림 (docs/user-accounts.md, 값은 deploy/windows/setup-userdb.ps1 이 채움)
# 사용자 DB(Postgres) 접속 주소. 비어 있으면 로그인 관련 API 는 503
USER_DATABASE_URL=
# 웹 푸시 키. 비어 있으면 알림만 비활성
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
