# 폴링 간격(ms). 실서비스는 60000~300000 권장.
POLL_INTERVAL_MS=60000

# 데모용: N 사이클 후 자동 종료 (0 = 무한 실행)
MAX_CYCLES=0

# 저장소 선택: sqlite(기본, 자체 DB) | memory | postgres
STORE=sqlite

# SQLite 파일 경로
DB_PATH=./data/vmoa.db

# REST API 포트
API_PORT=4000

# 치지직 라이브 페이징 수 (50개/페이지). 8이면 상위 400개를 훑어 버튜버를 걸러냄.
# 치지직엔 '버추얼' 카테고리가 없어 전체 라이브를 훑어야 커버리지가 나온다.
CHZZK_PAGES=8

# 스냅샷 보존 기간(일). 초과분 자동 삭제로 DB 무한 증가 방지.
RETENTION_DAYS=7

# 유저 데이터 API(즐겨찾기 등) 보호용 공유 시크릿. 웹 서버와 동일 값으로.
# 비어있으면 유저 API는 401(비활성). 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SECRET=

# postgres 사용 시 연결 문자열
# DATABASE_URL=postgres://user:pass@host:5432/vmoa

# ---- 이슈 자동 수집 (Claude 구독 + Claude Code 헤드리스) — docs/issue-collector.md
# 1 이면 ISSUES_INTERVAL_MIN 마다 웹 검색으로 이슈를 정리해 올림
ISSUES_ENABLED=0
ISSUES_INTERVAL_MIN=180
ISSUES_MAX_PER_RUN=5
# claude.exe 경로 (비우면 자동 탐색). 배포 PC(SYSTEM 실행)에서는 절대 경로 필수
CLAUDE_BIN=
# 구독 인증 토큰 (`claude setup-token` 으로 발급). API 키는 쓰지 않음
CLAUDE_CODE_OAUTH_TOKEN=
# 모델 (비우면 구독 계정 기본값)
CLAUDE_MODEL=
# 신규 데뷔 웹 수집 (기본: ISSUES_ENABLED 를 따라감) — 주기(분)·1회 최대 건수
# DEBUTS_ENABLED=1
DEBUTS_INTERVAL_MIN=360
DEBUTS_MAX_PER_RUN=15
