# 백엔드(자체 DB + API) 주소. 없으면 치지직 직접 조회로 폴백.
BACKEND_URL=http://localhost:4000
# 운영(Vercel): BACKEND_URL=https://api.vmoa.live

# 배포 도메인 (sitemap·robots·OG·canonical 등에 사용)
SITE_URL=http://localhost:3000
# 운영(Vercel): SITE_URL=https://vmoa.live

# Google AdSense 퍼블리셔 ID (승인 후 발급, 예: ca-pub-0000000000000000)
# 설정 시에만 광고 스크립트·슬롯·ads.txt 가 활성화됨.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
# 광고 단위 ID (승인 후 애드센스에서 광고 단위를 만들면 나오는 숫자). 없으면 그 자리는 비워 둔다 (자동 광고만 쓸 때)
# NEXT_PUBLIC_ADSENSE_SLOT_HOME_MID=0000000000
# NEXT_PUBLIC_ADSENSE_SLOT_ISSUE_BOTTOM=0000000000

# 문의 페이지에 표시할 운영자 이메일
# NEXT_PUBLIC_CONTACT_EMAIL=you@example.com

# 검색엔진 소유 확인 — HTML 태그 방식을 쓸 때만 (도메인 속성/DNS TXT 로 확인했다면 불필요). docs/search-console.md
# GOOGLE_SITE_VERIFICATION=
# NAVER_SITE_VERIFICATION=

# 로그인 (docs/user-accounts.md). 아래가 모두 있어야 로그인 기능이 켜짐
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=https://vmoa.live
# 백엔드 server/.env 의 INTERNAL_SECRET 과 같은 값
# INTERNAL_SECRET=
