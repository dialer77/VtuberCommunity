# 백엔드(자체 DB + API) 주소. 없으면 치지직 직접 조회로 폴백.
BACKEND_URL=http://localhost:4000

# 배포 도메인 (sitemap·robots·OG·canonical 등에 사용)
SITE_URL=http://localhost:3000

# Google AdSense 퍼블리셔 ID (승인 후 발급, 예: ca-pub-0000000000000000)
# 설정 시에만 광고 스크립트·슬롯·ads.txt 가 활성화됨.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000

# 문의 페이지에 표시할 운영자 이메일
# NEXT_PUBLIC_CONTACT_EMAIL=you@example.com
